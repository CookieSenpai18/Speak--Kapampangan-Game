  - m_Id: 52211779784704
    m_Localized: Bilang da reng ustung sagut
    m_Metadata:
      m_Items: []
  - m_Id: 52487647547392
    m_Localized: Bilang da reng mialing sagut
    m_Metadata:
      m_Items: []
  - m_Id: 52857975230464
    m_Localized: Tatawling puntus
    m_Metadata:
      m_Items: []
  - m_Id: 53755396902912
    m_Localized: 'Pekamatas a sunud-sunud a ustung saagut '
    m_Metadata:
      m_Items: []
  - m_Id: 54636301406208
    m_Localized: Kabuuang ginamit a saup
    m_Metadata:
      m_Items: []
  - m_Id: 56887816376320
    m_Localized: Bilang da reng ustung pakibat king mumunang pili. Mituknap ing streak
      nung mika mali kang pakibat.
    m_Metadata:
      m_Items: []
  - m_Id: 579119885996032
    m_Localized: Pamanayus
    m_Metadata:
      m_Items: []
  - m_Id: 573462176747520
    m_Localized: Gulisak bang Manyambut!
    m_Metadata:
      m_Items: []
  - m_Id: 545575730040832
    m_Localized: Alang kapupusan
    m_Metadata:
      m_Items: []
  - m_Id: 524496789721088
