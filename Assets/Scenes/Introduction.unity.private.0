    MATALOTI\r\nMATARAM \u2013 MAPURUL\r\nMATARIK \u2013 PATAG\r\nMATIBE \u2013 MARUPUK\r\nMATUNUD
    \u2013 MAMULANG\r\nMATIPID \u2013 MAGASTUS\r\nMATSURA \u2013 MALAGU\r\nMAYAN
