      m_Calls: []
  m_text: "AMINAN \u2013 TANGGIYAN\r\nARAP \u2013 GULUT\r\nAREN \u2013 DENI\r\nATAKI
    \u2013 DEPENSA\r\nATIN \u2013 ALA\r\nALIWA \u2013 PAREWU\r\nALANG ALAGA \u2013
    ULAGA\r\nBABO \u2013 LALAM\r\nBAGYU \u2013 MATUNUD\r\nBALUKTUT \u2013 MATULID\r\nBANWA
    \u2013 IMPIYERNU\r\nBASA \u2013 MALANGI\r\nBAYU \u2013 LUMA\r\nBENGI \u2013 ABAK\r\nBIASA
    \u2013 LOKU\r\nBURAN \u2013 MANYULAT\r\nBURING-BURI \u2013 ALANG INTERES\r\nBUMAWAS
    \u2013 DAGDAGAN\r\nDATANG \u2013 MAKO\r\nDINE \u2013 DANGALAN\r\nDAKPAN \u2013
    TAKAS\r\nDINAN \u2013 TANGGAP\r\nE SIGURADU \u2013 SIGURADU\r\nE USTU \u2013
    KATUTWAN\r\nE SIKASU \u2013 PANSINAN\r\nGULISAK \u2013 BULUNG\r\nGAMITAN \u2013
    IBASURA\r\nGAWAN \u2013 SIRAN\r\nGUMATO \u2013 LUMBUG\r\nGLORYA \u2013 KARINAYAN\r\nIGANTI
    \u2013 MALATI\r\nIBALUKTUT \u2013 ITULID\r\nIGLIP \u2013 GISING\r\nILELE \u2013
    MAGLAKO\r\nKABISADU \u2013 MAKAPAGMUMULA\r\nKANDADU \u2013 MAKABUKLAT\r\nKATATWALIAN
    \u2013 MISUNDU\r\nKILUB \u2013 LUAL\r\nNGENI \u2013 DATI\r\nLARAINAN \u2013 SIRAN\r\nLASUN
    \u2013 PAKAKAYAP\r\nLIKU-LIKU \u2013 MATULID\r\nLUGUD \u2013 ALI SIKASU\r\nLUKLUK
    \u2013 TALAKAD\r\nLUNDAG \u2013 LABWAD\r\nMAINGAT \u2013 PABAYA\r\nMAKAPAL \u2013
    MAIMPIS\r\nMAKALTO \u2013 IMBISIBOL\r\nMAKAMATAY \u2013 PANATAG\r\nMAKIPAGKASUNDU
    \u2013 E MIKASUNDU\r\nMAKIRAMDAM \u2013 E SIKASU\r\nMAKASALIKUT \u2013 MAKALTO\r\nMAKASARA
    \u2013 MAKABUKLAT\r\nTULUY \u2013 TUKNANG\r\nMAKUPAD \u2013 MABILIS\r\nMALAGAD
